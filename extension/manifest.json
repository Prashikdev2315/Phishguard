{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "0.1.0",
  "description": "On-device ML phishing detection. Zero data sent off-device.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_title": "PhishGuard"
  },
  "options_page": "src/pages/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  },
  "web_accessible_resources": []
}
